<idea-plugin>
    <id>com.trono.intellij.agentplugin</id>
    <name>Intelli Agent Plugin</name>
    <vendor email="support@example.com">Trono Labs</vendor>

    <description><![CDATA[
    MVP IntelliJ plugin scaffold for ACP-like agent workflows with IntelliJ-native features.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Intelli Agent"
                    anchor="right"
                    factoryClass="com.trono.agentplugin.toolwindow.AgentToolWindowFactory"
                    icon="/icons/agent.svg"
                    canCloseContents="false"/>
    </extensions>

    <actions>
        <action id="com.trono.agentplugin.OpenAgentToolWindowAction"
                class="com.trono.agentplugin.toolwindow.OpenAgentToolWindowAction"
                text="Open Intelli Agent"
                description="Open the Intelli Agent tool window">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
